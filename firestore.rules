rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isParkPalAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/parkpalAdminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/parkpalAdminUsers/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/parkpalAdminUsers/$(request.auth.uid)).data.role in [
          'superAdmin',
          'admin',
          'support',
          'reviewer',
          'pioneerManager',
          'atlasManager'
        ];
    }

    function isContributor() {
      return signedIn()
        && request.auth.token.role in ['pioneer', 'rider', 'admin'];
    }

    function changedOnly(allowedFields) {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(allowedFields);
    }

    match /parkpal_signs/{signId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.signId == signId
        && request.resource.data.capturedByUserId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending'
        && !(request.resource.data.keys().hasAny(['verifiedBy', 'verifiedAt']));
      allow update: if isAdmin()
        || (
          isContributor()
          && resource.data.capturedByUserId == request.auth.uid
          && resource.data.verificationStatus == 'pending'
          && request.resource.data.verificationStatus == 'pending'
          && changedOnly([
            'photoUrl',
            'thumbnailUrl',
            'rawText',
            'streetName',
            'borough',
            'council',
            'postcode',
            'geoPoint',
            'latitude',
            'longitude',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /parkpal_roads/{roadId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /parkpal_zones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /parkpal_reports/{reportId} {
      allow read: if isAdmin()
        || isParkPalAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reportId == reportId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin()
        || (
          isContributor()
          && resource.data.userId == request.auth.uid
          && resource.data.status in ['open', 'reviewing']
          && request.resource.data.status in ['open', 'reviewing']
          && changedOnly([
            'description',
            'photoUrl',
            'geoPoint',
            'streetName',
            'borough',
            'council',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /parkpal_contributors/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.role in ['public_user', 'rider', 'pioneer'];
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'role',
            'pioneerNumber',
            'contributionCount',
            'verifiedContributionCount',
            'rejectedContributionCount',
            'mappingPoints',
            'assignedBoroughs'
          ])
        );
      allow delete: if isAdmin();
    }

    match /parkpal_queries/{queryId} {
      allow read: if isAdmin()
        || isParkPalAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if request.resource.data.queryId == queryId
        && (
          (signedIn() && request.resource.data.userId == request.auth.uid)
          || (!signedIn() && request.resource.data.userId == null)
        );
      allow update, delete: if isAdmin();
    }

    match /parkpal_councils/{councilId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isParkPalAdmin();
    }

    match /parkpalAdminUsers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 1;
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role == 'superAdmin'
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == 'bootstrap'
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'status',
          'createdBy',
          'createdAt',
          'lastLoginAt'
        ]);
      allow update: if isOwner(userId)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['lastLoginAt']);
      allow update, delete: if isAdmin();
    }

    match /parkpal_atlas_roads/{roadId} {
      allow read: if isParkPalAdmin();
      allow create, update, delete: if isParkPalAdmin();
      match /history/{historyId} {
        allow read, create: if isParkPalAdmin();
        allow update, delete: if false;
      }
    }

    match /parkpal_iris_inspector_findings/{findingId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_pioneer_missions/{missionId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_iris_coverage_forecasts/{forecastId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_borough_coverage_scores/{scoreId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_iris_road_priorities/{roadId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_aie_sources/{sourceId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_aie_import_logs/{logId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpal_aie_change_records/{changeId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpal_aie_conflicts/{conflictId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpal_aie_dead_letters/{deadLetterId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpal_aie_audit_logs/{auditId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpal_aie_api_rate_limits/{limitId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpal_atlas_knowledge_roads/{roadId} {
      allow read: if true;
      allow create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
      match /versions/{versionId} {
        allow read: if true;
        allow create: if isParkPalAdmin();
        allow update, delete: if false;
      }
    }

    match /parkpal_atlas_intelligence_records/{recordId} {
      allow read: if true;
      allow create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
      match /versions/{versionId} {
        allow read: if isParkPalAdmin();
        allow create: if isParkPalAdmin();
        allow update, delete: if false;
      }
    }

    match /parkpalEvidenceRecords/{recordId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpalAppealSupportCases/{caseId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpalIrisReviewQueue/{reviewId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpalAdminAlerts/{alertId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if isAdmin();
    }

    match /parkpalOperationalSettings/{settingsId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpalPaymentCustomers/{customerId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpalSubscriptions/{subscriptionId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpalInvoices/{invoiceId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpalPaymentEvents/{eventId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpalPaymentLedger/{entryId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    match /parkpalPaymentProviderConfig/{configId} {
      allow read, create, update: if isParkPalAdmin();
      allow delete: if false;
    }

    match /parkpalPaymentAudit/{auditId} {
      allow read, create: if isParkPalAdmin();
      allow update, delete: if false;
    }

    // Roth is server-authoritative. Customers can inspect only their own state;
    // all financial mutations are performed by trusted Functions transactions.
    match /parkpal_roth_wallets/{userId} {
      allow get: if isOwner(userId) || isParkPalAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /parkpal_roth_ledger/{entryId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || isParkPalAdmin());
      allow list: if signedIn() && isParkPalAdmin();
      allow create, update, delete: if false;
    }

    match /parkpal_roth_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
